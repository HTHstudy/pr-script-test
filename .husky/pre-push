# G3 — 아래 npm run verify 는 push 되는 커밋의 내용이 아니라 지금 디스크의 작업
# 트리를 그대로 스캔한다(check:tokens 는 app/·src/ 를 rglob 한다, stdin 으로 오는
# refs 는 안 본다). 트리가 지저분하면(staged 든 unstaged 든 커밋 안 된 변경이 있으면)
# 이 검사가 통과해도 아무것도 보장하지 못한다 — 지금 디스크와 실제로 push 되는 커밋의
# 내용이 다를 수 있기 때문이다. 그래서 dirty 면 verify 를 돌리기 전에 먼저 거부한다.
# 이 훅은 "지금 작업 트리가 깨끗한가"만 본다 — push 되는 실제 커밋 내용을 검증하는
# 것은 여기서 하지 않는다(GitHub Actions 로 CI 가 생기면 그쪽이 맡는다).
if ! git diff --quiet; then
  echo "작업 트리에 커밋되지 않은 변경이 있다 — 이 훅은 디스크를 그대로 스캔하므로" >&2
  echo "지금 통과해도 push 되는 커밋 내용을 보장하지 않는다." >&2
  echo "커밋하거나(git add 후 git commit) git stash 로 정리한 뒤 다시 push 하라." >&2
  exit 1
fi

npm run verify || exit 1
