{
  "extraKnownMarketplaces": {
    "marblex-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/netmarble-marblex/developer-claude-plugin.git"
      }
    }
  },
  "enabledPlugins": {
    "frontend@marblex-plugins": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-verify-guard.sh", "timeout": 10000 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh", "timeout": 120000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quick-check.sh", "timeout": 30000 }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(./DESIGN.md)",
      "Edit(./src/app/global.css)",
      "Edit(./src/shared/api/**)",
      "Edit(./eslint.config.mjs)",
      "Edit(./tsconfig.json)",
      "Edit(./next.config.ts)",
      "Edit(./scripts/**)",
      "Edit(./.claude/**)",
      "Edit(./.husky/**)",
      "Read(./.env*)"
    ],
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run check:tokens)"
    ]
  }
}
