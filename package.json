{
  "name": "pr-script-test",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/run-python.mjs scripts/check-design-tokens.py",
    "test:gate": "node scripts/run-python.mjs --cwd scripts test_design_tokens.py",
    "verify": "npm run lint && npm run typecheck && npm run check:tokens",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "next": "16.3.4",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.67.0"
  }
}
